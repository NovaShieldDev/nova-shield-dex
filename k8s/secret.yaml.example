# Bu dosyayı kopyalayıp gerçek değerlerle doldurun:
#   cp k8s/secret.yaml.example k8s/secret.yaml
# secret.yaml'ı GİT'E EKLEMEYİN (.gitignore'a ekleyin).
#
# Değerleri base64 ile kodlayın:
#   echo -n "gizli-deger" | base64

apiVersion: v1
