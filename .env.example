# Nova DEX — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# ── nova-dex-server ───────────────────────────────────────────────────────────

# HTTP API dinleme portu (varsayılan: 3000)
PORT=3000

# PostgreSQL bağlantı URL'si (zorunlu)
DATABASE_URL=postgres://nova:nova_secret@localhost:5432/nova_dex

# Redis bağlantı URL'si (varsayılan: localhost:6379)
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL şifresi (yalnızca docker-compose için kullanılır)
POSTGRES_PASSWORD=nova_secret

# Nova L1 RPC URL — ayarlanmazsa L1 bakiye kontrolü devre dışı kalır
# NOVA_L1_RPC_URL=http://localhost:9944

# 1 NOVA'nın fiyatı (USD sent, örn. 250 = $2.50). Varsayılan: 250
NOVA_PRICE_CENTS=250

# /v1/payouts/process endpoint'i için Bearer token (ayarlanmazsa 401 döner)
# PAYOUT_SECRET=gizli-token-buraya

# CORS izin verilen origin (varsayılan: http://localhost:3001, "*" = herkese açık — production'da kullanmayın)
ALLOWED_ORIGIN=http://localhost:3001

# TLS sertifika yolları (ayarlanmazsa HTTP modunda çalışır)
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem

# ── apps/web ─────────────────────────────────────────────────────────────────

# Frontend'in bağlandığı DEX API adresi (varsayılan: http://localhost:3000)
NEXT_PUBLIC_DEX_API=http://localhost:3000

# ── nova-rpc (nova-shield-chain) ─────────────────────────────────────────────

# nova-rpc'nin bağlandığı DEX sunucu adresi (varsayılan: http://localhost:3000)
NOVA_DEX_URL=http://localhost:3000
